{
  "crons": [
    {
      "path": "/api/crm?action=reactivate_inactive_leads",
      "schedule": "0 14 * * *"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "src/**"
    }
  },
    {
      "source": "/api/test-send-whatsapp",
      "destination": "/api/test-send-whatsapp"
    },
    {
      "source": "/api/test-evolution-status",
      "destination": "/api/test-evolution-status"
    },
    {
      "source": "/api/whatsapp-webhook",
      "destination": "/api/whatsapp-webhook"
    },
    {
      "source": "/api/whatsapp/oauth",
      "destination": "/api/whatsapp/oauth"
    },
    {
      "source": "/api/whatsapp/webhook",
      "destination": "/api/whatsapp-webhook"
    },
    {
      "source": "/api/crm/leads",
      "destination": "/api/crm/leads"
    },
    {
      "source": "/api/crm-credentials",
      "destination": "/api/crm/credentials"
    },
    {
      "source": "/api/crm-sync",
      "destination": "/api/crm/sync"
    },
    {
      "source": "/api/leads",
      "destination": "/api/crm/leads"
    },
    {
      "source": "/api/chat",
      "destination": "/api/v1/chat"
    },
    {
      "source": "/api/paddle-webhook",
      "destination": "/api/v1/paddle-webhook"
    },
    {
      "source": "/api/verify-transaction",
      "destination": "/api/v1/verify-transaction"
    },
    {
      "source": "/api/properties",
      "destination": "/api/v1/properties"
    },
    {
      "source": "/api/bot-config",
      "destination": "/api/v1/bot-config"
    },
    {
      "source": "/api/usage",
      "destination": "/api/v1/usage"
    },
    {
      "source": "/api/health",
      "destination": "/api/v1/health"
    },
    {
      "source": "/api/cron/clean-demo-accounts",
      "destination": "/api/v1/cron/clean-demo-accounts"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}