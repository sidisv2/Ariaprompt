{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/webhook/whatsapp",
      "destination": "/api/webhook/whatsapp"
    },
    {
      "source": "/api/whatsapp/:match*",
      "destination": "/api/whatsapp?route=:match*"
    },
    {
      "source": "/api/crm/:match*",
      "destination": "/api/crm?route=:match*"
    },
    {
      "source": "/api/v1/:match*",
      "destination": "/api/v1/[...route]?route=:match*"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
